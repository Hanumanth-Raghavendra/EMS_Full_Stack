# =====================================================================
# EMS configuration reference.
# The API reads these as environment variables; none are required for a
# quick local start (sensible defaults apply), but every shared or
# production deployment must set JWT_SECRET and the database settings.
# =====================================================================

# ---- Database (either DB_* or a single DATABASE_URL) -------------------
DB_URL=jdbc:postgresql://localhost:5432/hr_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
# DATABASE_URL=postgresql://user:password@host:5432/hr_db?sslmode=require

# ---- Security ----------------------------------------------------------
# 32+ random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Session length in milliseconds (default 8 hours)
JWT_EXPIRATION_MS=28800000
# Browser origins allowed to call the API (comma separated, wildcards ok)
ALLOWED_ORIGINS=http://localhost:5173
# Optional one-time token required by the "create first admin" screen
SETUP_TOKEN=
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- Behaviour -----------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
# Seed sample data into an EMPTY database (great for a portfolio demo)
DEMO_DATA=false
DEMO_PASSWORD=Demo@12345
API_DOCS_ENABLED=true
PORT=8080

# ---- Frontend (hr-frontend/.env) ----------------------------------------
# VITE_API_URL=http://localhost:8080
